    "def count_words(s):\n",
    "  s=s.split()\n",
    "  count=0\n",
    "  for i in  range(len(s)):\n",
    "    count+=1\n",
    "  return count\n",
    "print(count_words(\"One two three four, five SIX seven two eight nine ten .\"))"
